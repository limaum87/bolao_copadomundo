# MIME type do Web App Manifest
AddType application/manifest+json .webmanifest

# Service worker NUNCA deve ser cacheado agressivamente pelo navegador/proxy,
# senão atualizações demoram a chegar.
<FilesMatch "^(sw\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# O manifest também deve revalidar.
<FilesMatch "\.webmanifest$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Segurança básica
<FilesMatch "\.(md|txt|json|db|sqlite|env|sh)$">
    Require all denied
</FilesMatch>

# Manifest dinâmico: /manifest.webmanifest é gerado por manifest.php,
# que define o start_url do PWA por participante (cookie bolao_uid).
RewriteEngine On
RewriteRule ^manifest\.webmanifest$ manifest.php [L]
