# Configuração do sync automático
# Copie para .env.sync e preencha

# URL do backend (quando rodando fora do docker)
BOLAO_API_URL=http://localhost:5026

# Opção 1: Token JWT direto
# BOLAO_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIs...

# Opção 2: Login (o script faz login automaticamente)
ADMIN_USER=admin
ADMIN_PASS=admin
