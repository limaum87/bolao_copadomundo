# Web Push (VAPID) — Bolão Copa 2026
# Copie este arquivo para `.env` (raiz do projeto) e preencha.
# O docker-compose lê automaticamente o `.env` da raiz.
#
# Gere as chaves com:
#   docker compose exec backend python -m backend.generate_vapid

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# Lembrete de palpite: quantos minutos antes do jogo avisar quem ainda
# não palpitar. Default: 120 (2h).
BOLAO_REMINDER_WINDOW_MIN=120

# Intervalo (segundos) entre checagens do scheduler de lembretes.
# Default: 300 (5 min).
BOLAO_NOTIFY_INTERVAL=300

# Lembrete diário: a partir de qual hora (0-23, horário de Brasília) o
# scheduler dispara 1x/dia um aviso aos inscritos que ainda não completaram
# os palpites dos jogos do dia. Default: 11 (11h da manhã).
# ⚠️ Usado apenas como valor inicial na criação do banco; depois disso o
# valor é controlado pela tela de Configurações do admin (banco de dados).
BOLAO_DAILY_REMINDER_HOUR=11
